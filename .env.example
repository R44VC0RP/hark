# --- Website / API (apps/website) -----------------------------------------

# Public origin the browser uses. Dev default: the Vite server.
# Production: https://hark.fyi
APP_URL=http://localhost:5173

# Earlier public origins that keep serving the API, webhooks and MCP; browser
# page loads there redirect to APP_URL. Production: https://hark.ryan.ceo
# LEGACY_APP_URLS=
# Hark pass issuer, pinned by web apps. Production: https://hark.ryan.ceo
# APP_PASS_ISSUER=

# SQLite file. Dev default: ./data/hark.sqlite (relative to apps/website).
# Production (Docker): /data/hark.sqlite
DATABASE_URL=./data/hark.sqlite

# Required in production. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Google OAuth web credentials (Google Cloud Console → APIs & Services →
# Credentials → OAuth client ID, type "Web application").
# Authorized redirect URIs:
#   http://localhost:8787/api/auth/callback/google
#   https://hark.fyi/api/auth/callback/google
#   https://hark.ryan.ceo/api/auth/callback/google (kept for older clients)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign in with Apple. The Services ID is the web OAuth client; the bundle ID is
# the native iOS audience. The .p8 key remains server-only and accepts PEM text
# (with \n escapes) or a base64-encoded PEM. Web return URLs:
#   https://hark.fyi/api/auth/callback/apple
#   https://hark.ryan.ceo/api/auth/callback/apple (kept for older clients)
# Apple does not allow localhost web return URLs; use an HTTPS development host.
APPLE_SIGN_IN_SERVICE_ID=
APPLE_SIGN_IN_BUNDLE_ID=ceo.ryan.hark
APPLE_SIGN_IN_KEY_ID=
APPLE_SIGN_IN_PRIVATE_KEY=

# Optional: Expo access token (expo.dev → Account settings → Access tokens).
# Enables authenticated requests to the Expo Push Service.
EXPO_ACCESS_TOKEN=

# Direct APNs provider credentials for Live Activities. Server-only: never use
# EXPO_PUBLIC_ for the private key. APNS_PRIVATE_KEY accepts PEM text (with \n)
# or a base64-encoded PEM. Use sandbox for development builds and production
# for TestFlight/App Store builds.
APNS_KEY_ID=
APPLE_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=ceo.ryan.hark
APNS_ENVIRONMENT=sandbox

# Webhook limits measured over a rolling 60-second window.
SERVICE_RATE_LIMIT_PER_MINUTE=60
ACCOUNT_RATE_LIMIT_PER_MINUTE=300
PRO_SERVICE_RATE_LIMIT_PER_MINUTE=300
PRO_ACCOUNT_RATE_LIMIT_PER_MINUTE=1500

# Autumn production secret key. Used only by the website server.
AUTUMN_API_KEY=

# Comma-separated owner emails whose teams get unlimited seats with no team
# plan (comped accounts).
UNLIMITED_TEAM_OWNER_EMAILS=

# API port (Hono). The Vite dev server proxies /api and /hooks here.
PORT=8787

# --- Expo app (apps/expo) ---------------------------------------------------

# Where the app reaches the API. Use your machine's LAN IP in development so a
# physical iPhone can connect, e.g. http://192.168.1.20:8787
EXPO_PUBLIC_API_URL=http://localhost:8787

# EAS project id (from `eas init`); required for Expo push tokens.
EAS_PROJECT_ID=

# Apple Developer team id above is also consumed by native config plugins.
EXPO_PUBLIC_APNS_ENVIRONMENT=sandbox
