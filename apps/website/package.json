{
  "name": "@hark/website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"NODE_ENV=development PORT=8788 node --env-file=../../.env --import tsx --watch src/server/index.ts\" \"vite\"",
    "dev:api": "NODE_ENV=development PORT=8788 node --env-file=../../.env --import tsx --watch src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build && node --import tsx scripts/prerender-docs.tsx && node scripts/build-server.mjs",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@better-auth/expo": "^1.6.25",
    "@better-auth/oauth-provider": "1.6.25",
    "@hark/contracts": "workspace:*",
    "@hono/node-server": "^1.19.15",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "autumn-js": "1.2.44",
    "better-auth": "^1.6.25",
    "better-sqlite3": "^13.0.1",
    "drizzle-orm": "^0.45.2",
    "expo-server-sdk": "^6.1.0",
    "hono": "^4.13.11",
    "jose": "^6.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.27.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
