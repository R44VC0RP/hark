@@ -0,0 +1,89 @@
+import ActivityKit
+import Foundation
+
+public enum HarkLiveActivityTokenRegistrar {
+  public static func start() {
+    guard #available(iOS 17.2, *) else { return }
+    Task {
+      await HarkLiveActivityTokenCoordinator.shared.start()
+    }
+  }
+}
+
+@available(iOS 17.2, *)
+private actor HarkLiveActivityTokenCoordinator {
+  static let shared = HarkLiveActivityTokenCoordinator()
+
+  private var activityObserver: Task<Void, Never>?
+  private var tokenObservers: [String: Task<Void, Never>] = [:]
+  private var uploadedTokens: [String: String] = [:]
+
+  func start() {
+    guard activityObserver == nil else { return }
+
+    for activity in Activity<LiveActivityAttributes>.activities {
+      observe(activity)
+    }
+
+    activityObserver = Task {
+      for await activity in Activity<LiveActivityAttributes>.activityUpdates {
+        observe(activity)
+      }
+    }
+  }
+
+  private func observe(_ activity: Activity<LiveActivityAttributes>) {
+    guard tokenObservers[activity.id] == nil else { return }
+
+    tokenObservers[activity.id] = Task {
+      if let token = activity.pushToken {
+        await register(token, for: activity)
+      }
+      for await token in activity.pushTokenUpdates {
+        await register(token, for: activity)
+      }
+    }
+  }
+
+  private func register(
+    _ tokenData: Data,
+    for activity: Activity<LiveActivityAttributes>
+  ) async {
+    let token = tokenData.map { String(format: "%02x", $0) }.joined()
+    guard uploadedTokens[activity.id] != token else { return }
+    guard
+      let urlString = activity.attributes.tokenRegistrationURL,
+      let url = URL(string: urlString),
+      let registrationToken = activity.attributes.tokenRegistrationToken,
+      let deliveryId = activity.attributes.deliveryId
+    else { return }
+
+    let payload = [
+      "deliveryId": deliveryId,
+      "registrationToken": registrationToken,
+      "nativeActivityId": activity.id,
+      "updateToken": token,
+    ]
+    guard let body = try? JSONSerialization.data(withJSONObject: payload) else { return }
+
+    var request = URLRequest(url: url)
+    request.httpMethod = "POST"
+    request.setValue("application/json", forHTTPHeaderField: "Content-Type")
+    request.httpBody = body
+
+    for attempt in 0..<5 {
+      do {
+        let (_, response) = try await URLSession.shared.data(for: request)
+        if let http = response as? HTTPURLResponse, (200..<300).contains(http.statusCode) {
+          uploadedTokens[activity.id] = token
+          return
+        }
+      } catch {
+        // Retry within the background runtime ActivityKit grants for token delivery.
+      }
+
+      let delay = UInt64(1 << attempt) * 500_000_000
+      try? await Task.sleep(nanoseconds: delay)
+    }
+  }
+}
